# Ghostty configuration — managed by ~/.sys (see config/.dotfiles)
#
# Initial window size, in terminal grid cells: 100 columns x 25 rows.
window-width = 100
window-height = 25

# New windows and tabs start on the Desktop. Ghostty otherwise inherits the
# directory of whatever was focused, so they would land wherever the last one
# happened to be. Splits still inherit: splitting is for working on the same
# thing in the same place.
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true
working-directory = /Users/dwkns/Desktop
