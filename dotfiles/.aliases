# Aliases and small functions. Plain shell — no jq, no JSON, no eval.

# ── Navigation ───────────────────────────────────────────────────────────────
alias ls='ls -lha'
alias dt='cd ~/Desktop'
alias dev='cd ~/Developer && ls -lha'

# ── Editors ──────────────────────────────────────────────────────────────────
alias c.='code .'
alias ep='code ~/.sys/dotfiles/.zshrc'   # edit shell config
alias ea='code ~/.sys/dotfiles/.aliases'
alias rp='exec zsh'                                # reload the shell

# ── Git ──────────────────────────────────────────────────────────────────────
alias ga='git add -A'
alias gc='git commit'
alias gs='git status'
alias gl='git log --oneline -20'
alias gp='git push -u origin HEAD'
alias ghv='gh repo view --web'

# ── Functions ────────────────────────────────────────────────────────────────

# bin/sys runs as its own process, so it cannot reload the shell that started
# it. This passes it a flag file; if setup or sync changed anything it touches
# the flag, and the reload happens here, in your actual shell.
# Run sys, then reload this shell if setup or sync changed anything.
sys() {
  local flag="${TMPDIR:-/tmp}/sys-reload-$$"
  rm -f "$flag"
  SYS_RELOAD_FILE="$flag" command "$HOME/.sys/bin/sys" "$@"
  local rc=$?
  if [[ -e "$flag" ]]; then
    rm -f "$flag"
    (( rc == 0 )) && exec zsh
  fi
  return $rc
}

# Kill whatever is listening on a port.  kp 3000
kp() {
  [[ -n "$1" ]] || { error "usage: kp <port>"; return 1; }
  local pids; pids="$(lsof -t -i tcp:"$1" 2>/dev/null)"
  [[ -n "$pids" ]] && kill -9 ${=pids} || note "Nothing on port $1"
}

# Delete every node_modules below here.
dnode() {
  doing "Deleting node_modules folders"
  find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +
}
