#!/usr/bin/env python3
"""List the machines this one can reach over SSH (`sys ssh`).

Status, not guesswork: every machine in config/ssh/access is shown with both
of its routes actually probed — the Tailscale name, and NAME.local on the home
network — so "not reachable" means this machine just tried and failed, and
Tailscale being off is stated once rather than making every row look broken.

  sys ssh       the machines sys manages
  sys ssh all   those, plus anything hand-written in ~/.ssh/config
"""
import glob, json, os, pathlib, socket, subprocess, sys, threading, time

# The same four as lib/common.sh: grey is supporting copy, green is good,
# red is a problem, white is the subject — titles, machines, commands.
# WHITE leads with 22 so it cancels dim: bold alone inside a grey sentence
# stays grey. See lib/common.sh, which defines the same five.
GREY, GREEN, RED, WHITE, R = "\033[2m", "\033[0;32m", "\033[0;31m", "\033[22;1;97m", "\033[0m"
ORANGE = "\033[38;5;208m"
SSH_DIR = pathlib.Path.home() / ".ssh"
MANAGED = SSH_DIR / "config.d" / "sys"
ROOT = pathlib.Path(os.environ.get("ROOT_DIR", pathlib.Path.home() / ".sys"))
ACCESS = ROOT / "config" / "ssh" / "access"
SHOW_ALL = "all" in sys.argv[1:]
TIMEOUT = 2.0        # per connection attempt
DEADLINE = 3.5       # for the whole check, however slow name lookup is


def rule(title, emoji):
    line = "─" * 56
    print(f"\n{GREY}{line}{R}\n {emoji}  {WHITE}{title}{R}\n{GREY}{line}{R}\n")


def probe(host, into, key, port=22):
    """Is anything answering on port 22? Run in a daemon thread: a name that
    does not resolve can block for seconds inside getaddrinfo, long past the
    socket timeout, and nothing should wait for that."""
    try:
        socket.create_connection((host, port), timeout=TIMEOUT).close()
        into[key] = True
    except Exception:
        into[key] = False


def access_rows():
    """machine, account — from config/ssh/access, this machine left out."""
    me = socket.gethostname().split(".")[0].lower()
    rows = []
    if not ACCESS.is_file():
        return me, rows
    for raw in ACCESS.read_text(errors="replace").splitlines():
        line = raw.split("#", 1)[0].split()
        if len(line) >= 2 and line[0] != me:
            rows.append((line[0], line[1]))
    return me, rows


def tailscale_state():
    """(running, self name, tailnet name). running is False when the daemon is
    off or logged out — the case that used to be reported as every host being
    stale. The tailnet name (dwkns.github) labels the route it belongs to."""
    for cmd in ("tailscale", "/Applications/Tailscale.app/Contents/MacOS/Tailscale",
                "/usr/local/bin/tailscale"):
        try:
            out = subprocess.run([cmd, "status", "--json"], capture_output=True,
                                 timeout=10, check=True).stdout
        except Exception:
            continue
        try:
            d = json.loads(out)
        except ValueError:
            continue
        net = (d.get("CurrentTailnet") or {}).get("Name", "")
        if (d.get("BackendState") or "") != "Running":
            return False, "", net
        me = (d.get("Self") or {}).get("DNSName", "").rstrip(".").split(".")[0]
        return True, me, net
    return False, "", ""


def ssh_config_hosts(path=SSH_DIR / "config", seen=None, by_alias=None):
    """Host blocks from ~/.ssh/config, following Include lines."""
    seen = seen if seen is not None else set()
    by_alias = by_alias if by_alias is not None else {}
    if not path.is_file() or path in seen:
        return []
    seen.add(path)
    hosts, cur = [], []
    for raw in path.read_text(errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 1)
        key = parts[0].lower()
        val = parts[1].strip() if len(parts) > 1 else ""
        if key == "include":
            for pattern in val.split():
                pattern = os.path.expanduser(pattern)
                if not os.path.isabs(pattern):
                    pattern = str(SSH_DIR / pattern)
                for inc in sorted(glob.glob(pattern)):
                    hosts.extend(ssh_config_hosts(pathlib.Path(inc), seen, by_alias))
            cur = []
        elif key == "match":
            cur = []
        elif key == "host":
            cur = []
            for alias in val.split():
                if "*" in alias or "?" in alias:
                    continue
                if alias not in by_alias:
                    by_alias[alias] = {"alias": alias, "hostname": "", "user": "",
                                       "managed": path == MANAGED}
                    hosts.append(by_alias[alias])
                cur.append(by_alias[alias])
        elif cur and key in ("hostname", "user"):
            for h in cur:
                h[key] = h[key] or val
    return hosts


def alias_of(machine, machines):
    """dwkns-mini -> mini, when every machine shares the first segment."""
    if not all("-" in m for m in machines):
        return machine
    prefix = machines[0].split("-")[0] + "-"
    if all(m.startswith(prefix) and len(m) > len(prefix) for m in machines):
        return machine[len(prefix):]
    return machine


me, rows = access_rows()
ts_on, ts_self, ts_net = tailscale_state()
machines = [r[0] for r in rows]
tty = sys.stdout.isatty()

extra = []
if SHOW_ALL:
    managed_aliases = {alias_of(m, machines) for m in machines}
    for h in ssh_config_hosts():
        if h["managed"] or h["alias"] in managed_aliases or not h["hostname"]:
            continue
        extra.append(h)

# Start every probe at once, in daemon threads: the commands are printed
# immediately and each line is filled in as its answer arrives.
found = {}
for machine in machines:
    for kind, host in (("tailnet", machine), ("local", machine + ".local")):
        threading.Thread(target=probe, args=(host, found, (machine, kind)),
                         daemon=True).start()
for h in extra:
    threading.Thread(target=probe, args=(h["hostname"], found, (h["alias"], "direct")),
                     daemon=True).start()

rule("SSH hosts", "🔌")
if ts_on:
    print(f"  {GREEN}Tailscale on{R}{GREY} — this machine is {ts_self}{R}")
else:
    print(f"  {ORANGE}Tailscale off{R}{GREY} — local network only, so anything elsewhere is out of reach{R}")
print()

if not rows:
    print(f"  {GREY}Nothing in config/ssh/access yet{R}\n")
elif tty:
    print(f"  {GREY}Checking both routes for each — {WHITE}Ctrl-C{R}{GREY} to skip{R}\n")

width = max([len(alias_of(m, machines)) for m in machines] + [8])
lines = []          # one per printed row, bottom-up addressing
CHECKING = f"{GREY}checking…{R}"


def row_text(alias, who, target, status, dim=False):
    """The command in white, who and where in grey, the status in its own colour."""
    head = f"  {WHITE}ssh {alias:<{width}}{R}"
    return f"  {head} {GREY}{who}@{target}{R}  {status}"


# Printed straight away, so the commands are there to read (and copy) while
# the checks run. Only on a terminal, where the lines can be rewritten in
# place; piped output gets one clean set of rows at the end.
for machine, account in rows:
    lines.append((machine, "machine", alias_of(machine, machines), account))
    if tty:
        print(row_text(alias_of(machine, machines), account, machine, CHECKING))
if extra:
    if tty:
        print()
        print(f"  {WHITE}Hand-written in ~/.ssh/config{R}")
    for h in extra:
        lines.append((h["alias"], "extra", h["alias"], h["user"]))
        if tty:
            print(row_text(h["alias"], h["user"] or "", h["hostname"], CHECKING))


def status_for(key, kind):
    if kind == "machine":
        tail, local = found.get((key, "tailnet")), found.get((key, "local"))
        if tail is None and local is None:
            return CHECKING, False
        expected = RED if ts_on else ORANGE   # off on purpose is not a fault
        tailnet_label = f"{ts_net} tailnet" if ts_net else "tailnet"

        def mark(ok, label, miss):
            return f"{GREEN}{label} ✓{R}" if ok else f"{miss}{label} ✗{R}"

        if tail or local:
            return (f"  {mark(bool(tail), tailnet_label, expected)}"
                    f"  {mark(bool(local), 'local network', RED)}", False)
        if not ts_on:
            return f"{ORANGE}not reachable{R}{GREY} — Tailscale is off{R}", True
        return f"{RED}not reachable{R}", True
    got = found.get((key, "direct"))
    if got is None:
        return CHECKING, False
    return (f"{GREEN}reachable ✓{R}", False) if got else (f"{RED}not reachable ✗{R}", True)


drawn = {}


def redraw(index, key, kind, alias, who, target):
    """Rewrite one already-printed line in place, and only when its status has
    actually changed — otherwise the whole list repaints ten times a second."""
    status, dim = status_for(key, kind)
    text = row_text(alias, who, target, status, dim)
    if drawn.get(index) == text:
        return
    drawn[index] = text
    up = len(lines) - index
    sys.stdout.write(f"\033[{up}A\r\033[2K" + text + f"\033[{up}B\r")
    sys.stdout.flush()


targets = {m: m for m, _ in rows}
targets.update({h["alias"]: h["hostname"] for h in extra})
expected = len(machines) * 2 + len(extra)
try:
    deadline = time.time() + DEADLINE
    while time.time() < deadline and len(found) < expected:
        if tty:
            for i, (key, kind, alias, who) in enumerate(lines):
                redraw(i, key, kind, alias, who, targets[key])
        time.sleep(0.1)
except KeyboardInterrupt:
    # The escape hatch: the commands above are already usable, so stop the
    # checks and leave the list on screen rather than dumping a traceback.
    if tty:
        sys.stdout.write("\r\033[2K")
    print(f"\n  {GREY}Stopped checking — the commands above still work.{R}\n")
    os._exit(0)

# Anything still unanswered timed out: say so rather than leaving "checking…".
for machine in machines:
    for kind in ("tailnet", "local"):
        found.setdefault((machine, kind), False)
for h in extra:
    found.setdefault((h["alias"], "direct"), False)
if tty:
    for i, (key, kind, alias, who) in enumerate(lines):
        redraw(i, key, kind, alias, who, targets[key])
else:
    for key, kind, alias, who in lines:
        if kind == "extra" and key == extra[0]["alias"]:
            print()
            print(f"  {WHITE}Hand-written in ~/.ssh/config{R}")
        status, dim = status_for(key, kind)
        print(row_text(alias, who, targets[key], status, dim))

print()
if SHOW_ALL:
    print(f"  {GREY}More detail in {WHITE}sys ssh man{R}{GREY}.{R}\n")
else:
    print(f"  {GREY}Show all connections with {WHITE}sys ssh all{R}{GREY}, more detail in {WHITE}sys ssh man{R}{GREY}.{R}\n")
