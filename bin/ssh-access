#!/usr/bin/env bash
# For a machine that does not run sys (the Ubuntu box). One command:
#
#   curl -fsSL https://raw.githubusercontent.com/dwkns/sys/master/bin/ssh-access | bash
#
# Gets or updates the repo in ~/.sys, then runs `sys sync`, which on
# a machine that is not a Mac does just the repo update and SSH access: makes
# this machine's key if it has none, installs the keys of the machines let in,
# writes the aliases. Run it again whenever a machine is added.
set -euo pipefail

REPO="https://github.com/dwkns/sys.git"
DIR="${ROOT_DIR:-$HOME/.sys}"

command -v git >/dev/null 2>&1 || { echo "Installing git"; sudo apt-get install -y git; }

# Only cloned when missing: sys sync pulls the latest itself.
[ -d "$DIR/.git" ] || git clone --quiet "$REPO" "$DIR"

# So that from now on it is just `sys sync` here, like everywhere else.
mkdir -p "$HOME/.local/bin" && ln -sf "$DIR/bin/sys" "$HOME/.local/bin/sys"
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "Note: open a new terminal for the sys command to be found" ;; esac

exec "$DIR/bin/sys" sync
