#!/usr/bin/python3
"""Set a solid desktop colour from config/desktop-colour.

Makes a small PNG of the colour and sets it on every screen with NSWorkspace's
public setDesktopImageURL API, called through JavaScript for Automation. That
runs inside this process and sends no Apple Events, so there is no Automation
prompt, and it behaves the same on any recent macOS.

(An earlier version wrote macOS's private wallpaper store directly. That file
is undocumented, can change between macOS versions, and a correct file was
never proof the screen had changed.)

The result is read back from the system afterwards, so this only reports
success when every screen is really showing the new colour.

  set-desktop-colour            apply
  set-desktop-colour --dry-run  show what would be applied
  set-desktop-colour --check    is every screen showing it? exit 0 yes,
                                1 no, 2 no screens to check (e.g. over SSH)
"""
import json, os, pathlib, shutil, struct, subprocess, sys, time, zlib

DRY = "--dry-run" in sys.argv
CHECK = "--check" in sys.argv
root = pathlib.Path(os.environ.get("ROOT_DIR", pathlib.Path.home() / ".sys"))
cfg = root / "config" / "desktop-colour"
if not cfg.is_file():
    sys.exit(f"{cfg} is missing — nothing to apply")
line = next((l for l in cfg.read_text().splitlines() if l.strip() and not l.lstrip().startswith("#")), "")
try:
    r, g, b, a = (float(x) for x in line.split())
except ValueError:
    sys.exit(f"config/desktop-colour: expected four numbers, got {line!r}")

rgb8 = tuple(max(0, min(255, round(v * 255))) for v in (r, g, b))
hexcol = "#%02X%02X%02X" % rgb8
if DRY:
    print(f"would set desktop colour {hexcol}")
    sys.exit(0)

def write_png(path, rgb, size=64):
    row = b"\x00" + bytes(rgb) * size
    def chunk(kind, data):
        return (struct.pack(">I", len(data)) + kind + data
                + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF))
    path.write_bytes(b"\x89PNG\r\n\x1a\n"
                     + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0))
                     + chunk(b"IDAT", zlib.compress(row * size, 9))
                     + chunk(b"IEND", b""))

# One file per colour: macOS caches wallpaper by path, so reusing a single name
# for a different colour can leave the old colour on screen.
folder = pathlib.Path.home() / "Library/Application Support/sys"
image =folder / f"desktop-{hexcol[1:].lower()}.png"
if not CHECK:
    folder.mkdir(parents=True, exist_ok=True)
    write_png(image, rgb8)
    for old in folder.glob("desktop-*.png"):
        if old != image:
            old.unlink()

set_script = f"""
ObjC.import("AppKit");
const ws = $.NSWorkspace.sharedWorkspace;
const url = $.NSURL.fileURLWithPath({json.dumps(str(image))});
const opts = $.NSMutableDictionary.dictionary;
opts.setObjectForKey($.NSNumber.numberWithInt(1), $.NSWorkspaceDesktopImageScalingKey);
opts.setObjectForKey($.NSColor.colorWithCalibratedRedGreenBlueAlpha({r}, {g}, {b}, {a}),
                     $.NSWorkspaceDesktopImageFillColorKey);
const screens = $.NSScreen.screens;
let set = 0;
for (let i = 0; i < screens.count; i++)
  if (ws.setDesktopImageURLForScreenOptionsError(url, screens.objectAtIndex(i), opts, null)) set++;
JSON.stringify({{screens: Number(screens.count), set: set}});
"""

check_script = f"""
ObjC.import("AppKit");
const ws = $.NSWorkspace.sharedWorkspace;
const screens = $.NSScreen.screens;
let shown = 0;
for (let i = 0; i < screens.count; i++) {{
  const now = ws.desktopImageURLForScreen(screens.objectAtIndex(i));
  if (!now.isNil() && now.path.js === {json.dumps(str(image))}) shown++;
}}
JSON.stringify({{screens: Number(screens.count), shown: shown}});
"""

def jxa(src):
    res = subprocess.run(["/usr/bin/osascript", "-l", "JavaScript", "-e", src],
                         capture_output=True, text=True)
    try:
        # The ObjC bridge can hand counts back as strings; normalise to ints.
        return {k: int(v) for k, v in json.loads(res.stdout.strip()).items()}
    except (ValueError, TypeError):
        sys.exit(f"Could not set the desktop colour: {res.stderr.strip() or res.stdout.strip()}")

if CHECK:
    seen = jxa(check_script)
    if seen["screens"] == 0:
        print("no screens to check")
        sys.exit(2)
    print(f"{hexcol} on {seen['shown']} of {seen['screens']} screen(s)")
    sys.exit(0 if seen["shown"] == seen["screens"] else 1)

done = jxa(set_script)
if done["screens"] == 0:
    sys.exit("No screens available — run this from a logged-in desktop session, not over SSH.")

# macOS applies a new wallpaper asynchronously, so a check made straight away
# still sees the old one. Ask again, from a fresh process each time, for up to
# ten seconds before deciding it did not work.
seen = {"shown": 0, "screens": done["screens"]}
for _ in range(20):
    time.sleep(0.5)
    seen = jxa(check_script)
    if seen["shown"] == seen["screens"]:
        break

if seen["shown"] != seen["screens"]:
    sys.exit(f"Desktop colour {hexcol} showing on {seen['shown']} of {seen['screens']} screen(s).")
print(f"Desktop colour {hexcol} on {seen['screens']} screen(s)")

# The folder's name before the repo became "sys". Only now that the new image
# is on screen is the old one safe to delete.
shutil.rmtree(pathlib.Path.home() / "Library/Application Support/system-config", ignore_errors=True)
