#!/usr/bin/env bash
# One entry point for everything. Run `sys` with no arguments for help.
set -euo pipefail

export ROOT_DIR="${ROOT_DIR:-$HOME/.system-config}"
source "$ROOT_DIR/lib/common.sh"
source "$ROOT_DIR/lib/sync.sh"
source "$ROOT_DIR/lib/setup.sh"
source "$ROOT_DIR/lib/ssh.sh"
source "$ROOT_DIR/lib/net.sh"
source "$ROOT_DIR/lib/nas.sh"
source "$ROOT_DIR/lib/tailscale.sh"

usage() {
  # Commands in white, what they do in grey: the same scheme as every other
  # thing sys prints (see lib/common.sh).
  local c="$WHITE" g="$GREY" x="$RESET"
  printf '%ssys%s %s— system configuration%s\n\n' "$WHITE" "$RESET" "$GREY" "$RESET"
  while IFS='|' read -r cmd text; do
    [[ -z "$cmd$text" ]] && { echo; continue; }
    if [[ -z "$text" ]]; then printf '%s%s%s\n' "$g" "$cmd" "$x"
    else printf '  %s%-18s%s%s%s%s\n' "$c" "$cmd" "$x" "$g" "$(hl "$text" "$g")" "$x"
    fi
  done <<'USAGE'
sys setup|Set up this machine from scratch
sys sync|Pull the latest config and apply it here (apps, dotfiles, Dock, SSH…)
sys sync all|The same here, then on every machine this one may log into
sys push|Save this machine's config into the repo and push
sys doctor|Check that everything is where it should be
sys ai|Everything an AI needs to know about this repo, generated
|
sys ssh|The machines sys manages, and whether each is reachable
sys ssh all|The same, plus anything hand-written in ~/.ssh/config
sys ssh NAME|Log in and attach a tmux session no other connection is using
sys ssh harden|Keys only on this machine — optional, passwords stay on otherwise
sys ssh man|The manual
|
sys nas|The NAS: how to reach it, its disk, shares and Tailscale
sys nas open|Open the NAS's web page in the browser
sys tailscale up|Turn Tailscale on here, then on every machine this one may log into
sys net|List the network shares; {{sys net NAME}} connects to one
sys hostname|Set the computer name (asks, or pass one: {{sys hostname my-mac}})
sys extras|Install the optional extras (Office, Xcode, duckdb)
sys remove|Undo everything setup installed (asks first; --dry-run to preview)
|
Options|
--dry-run|Show what would happen, change nothing
--force|sync: reinstall and rebuild everything, even if nothing changed
--yes|Don't ask for confirmation (remove)
USAGE
  printf '\n%sFull documentation: %ssys ssh man%s\n' "$GREY" "$WHITE" "$RESET"
}

# Keep the original arguments: sync may have to re-exec after updating itself.
SYS_ARGV=("$@")
cmd="${1:-}"; [[ $# -gt 0 ]] && shift

ARG=""
ARGS=()   # every positional argument, in order (ARG is the last one)
export DRY_RUN="${DRY_RUN:-0}" ASSUME_YES="${ASSUME_YES:-0}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run|--dryrun) DRY_RUN=1 ;;
    --force)    export FORCE=1 ;;
    --yes|-y)   ASSUME_YES=1 ;;
    -*) die "Unknown option: $1" ;;
    *)  ARG="$1"; ARGS+=("$1") ;;
  esac
  shift
done

case "$cmd" in
  setup)
    is_macos || die "macOS only."

    # The same as the one-line installer: running it is the confirmation, and
    # it starts from the latest config, restarting if that updated sys itself.
    update_self

    printf '%s\n%s\n' "$GREY" "This takes 15-30 minutes. Two things to expect:"
    printf '%s\n' "  * You will be asked for your password once, right at the start. It will"
    printf '%s\n' "    not appear as you type, which is normal. That is the only time."
    printf '%s\n' "  * Some apps install with no output for several minutes. That is not a"
    printf '%s\n%s\n' "    hang. Leave it alone." "$RESET"

    acquire_sudo

    STARTED=$SECONDS
    header "🚀" "Setting up this Mac"
    STEP=0; TOTAL=11; FAILED=""
    # Output is never piped: buffering would make a slow step look frozen.
    step() {
      local icon="$1" name="$2"; shift 2
      STEP=$((STEP + 1))
      header "$icon" "$name" "[$STEP/$TOTAL]" "$WHITE"
      if "$@"; then :; else
        FAILED="$FAILED|$name"
        warn "$name did not finish — carrying on"
      fi
      return 0
    }

    step "📦" "Installing apps and tools"     install_packages
    step "📁" "Installing dotfiles"           sync_install
    step "🧪" "Installing language versions"  install_languages
    step "🧩" "Installing Cursor extensions"  install_editor_extensions
    step "📮" "Installing MailExporter"       install_mail_exporter
    step "🛒" "Installing App Store apps"     install_app_store_apps
    RUN_ONCE_NOTE=1 run_once hostname asked prompt_machine_name
    step "🔐" "Turning on Remote Login"       enable_remote_login
    step "🔑" "SSH key and access"            ssh_apply
    step "🧭" "Installing Paywall Down"       install_paywall_down
    step "📺" "Turning on Screen Sharing"     enable_screen_sharing
    step "🍎" "Applying macOS defaults"       apply_macos_defaults
    RUN_ONCE_NOTE=1 run_once dock "$(fingerprint "$ROOT_DIR/config/dock" "$ROOT_DIR/bin/set-dock")" configure_dock
    apply_input_settings
    RUN_ONCE_NOTE=1 run_once desktop "$(fingerprint "$ROOT_DIR/config/desktop-colour" "$ROOT_DIR/bin/set-desktop-colour")" set_desktop_colour
    set_default_terminal || true

    echo
    if [[ -n "$FAILED" ]]; then
      warn "Finished in $(elapsed $((SECONDS - STARTED))), but these steps had problems:"
      printf '%s' "$FAILED" | tr '|' '\n' | sed '/^$/d;s/^/      /'
    else
      ok "All $STEP steps completed in $(elapsed $((SECONDS - STARTED)))"
    fi

    echo
    "$0" doctor || true
    print_manual_steps
    request_reload

    # From the one-line installer there is no sys function to reload the
    # shell, so hand over a fresh login shell with the new config loaded.
    if [[ "${SYS_FROM_INSTALLER:-0}" == "1" ]] && { true </dev/tty; } 2>/dev/null; then
      release_sudo
      doing "Starting a fresh shell with your new config"
      exec /bin/zsh -l </dev/tty
    fi
    ;;

  sync)
    want_push=0
    doing "Fetching latest config"
    before="$(git -C "$ROOT_DIR" rev-parse HEAD 2>/dev/null || echo none)"

    # Reconcile with the remote in whichever direction is needed. Only ever
    # pushes commits that already exist — capturing this machine's state into
    # new commits stays 'sys push'. The one thing sync commits by itself is
    # this machine's own SSH public keys (see lib/ssh.sh).
    if git -C "$ROOT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
      run git -C "$ROOT_DIR" fetch --quiet origin || true
      upstream="$(git -C "$ROOT_DIR" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo '')"
      if [[ -n "$upstream" ]]; then
        read -r behind ahead <<<"$(git -C "$ROOT_DIR" rev-list --left-right --count "$upstream...HEAD" 2>/dev/null || echo '0 0')"

        if [[ "$behind" -gt 0 && "$ahead" -gt 0 ]]; then
          doing "Diverged — $ahead local, $behind remote. Replaying yours on top"
          # --autostash: an edited-but-uncommitted file here is set aside and
          # put back afterwards, instead of stopping the pull.
          if ! run git -C "$ROOT_DIR" pull --rebase --autostash --quiet; then
            die "The two sides changed the same lines. Fix it in $ROOT_DIR ({{git status}} shows where), then run {{sys sync}} again."
          fi
          want_push=1
        elif [[ "$behind" -gt 0 ]]; then
          run git -C "$ROOT_DIR" pull --ff-only --autostash --quiet || die "Could not pull. Check $ROOT_DIR."
          doing "Pulled $behind commit(s)"
        elif [[ "$ahead" -gt 0 ]]; then
          want_push=1
        fi
      fi
    fi

    after="$(git -C "$ROOT_DIR" rev-parse HEAD 2>/dev/null || echo none)"
    restart_if_updated "$before" "$after"

    # Push only now, after any restart, so a fix to the push itself is the
    # version that runs. The restarted sys sees itself as ahead and lands here.
    if [[ "${want_push:-0}" == "1" ]]; then
      push_repo && ok "Pushed $ahead commit(s)"
    fi

    # Not a Mac (the Ubuntu box): the repo update above and SSH access are
    # all sync does. Dotfiles, Homebrew and macOS settings are Mac things.
    if ! is_macos; then
      install_apt_packages || true
      install_shared_dotfiles
      install_bashrc_hook
      ssh_apply quiet
      ok "Done"
      [[ "$ARG" == "all" ]] && ssh_sync_others
      exit 0
    fi

    # Install packages when the Brewfile differs from the one last installed
    # here. Comparing against a recorded fingerprint rather than against this
    # pull catches a change made at any point — including one pulled before
    # this check existed, or a machine that has never run brew bundle.
    brew_changed=0
    brew_stamp="$ROOT_DIR/.state/brewfile"
    brew_now="$(fingerprint "$ROOT_DIR/Brewfile")"
    [[ "$(cat "$brew_stamp" 2>/dev/null)" != "$brew_now" ]] && brew_changed=1
    [[ "${FORCE:-0}" == "1" ]] && brew_changed=1

    sync_install
    # Every sync, not just when something changed: quick, and it is what
    # keeps typing and clicking identical across machines.
    apply_input_settings
    # SSH access from config/ssh/access: this machine's keys shared, the keys
    # it lets in installed, every other machine pinned and aliased. Quiet
    # unless something changed.
    ssh_apply quiet
    # Paywall Down: clone or update, rebuild when that commit changed.
    # Quiet when nothing did. Failure here must not stop the rest of sync.
    install_paywall_down quiet || true
    # The Dock and desktop colour: rebuilt when their config changes, like the
    # Brewfile. Edit config/dock, sys push, and every machine follows.
    run_once dock "$(fingerprint "$ROOT_DIR/config/dock" "$ROOT_DIR/bin/set-dock")" configure_dock
    run_once desktop "$(fingerprint "$ROOT_DIR/config/desktop-colour" "$ROOT_DIR/bin/set-desktop-colour")" set_desktop_colour

    if [[ "$before" == "$after" && "${SYNC_CHANGED:-0}" == "0" && "$brew_changed" == "0" && "${FORCE:-0}" != "1" ]]; then
      ok "Already up to date — nothing to apply"
    else
      if [[ "${FORCE:-0}" == "1" ]]; then
        doing "Forced — reinstalled ${SYNC_CHANGED} file(s)"
      elif [[ "${SYNC_CHANGED:-0}" != "0" ]]; then
        doing "Installed ${SYNC_CHANGED} changed file(s)"
      fi
      # Never --cleanup: that would uninstall anything installed by hand.
      # Run as you, with no stored password: the Brewfile is code from the
      # repo, and it gets no more than your own account already has. An app
      # that truly needs an admin password asks for it itself, then only.
      if [[ "$brew_changed" == "1" ]]; then
        show_brewfile_changes
        doing "Brewfile changed — installing what is new"
        install_packages || warn "{{brew bundle}} did not finish — will try again next sync"
      fi
      apply_macos_defaults
      request_reload
      if [[ -n "${SYS_RELOAD_FILE:-}" ]]; then
        ok "Done — reloading your shell"
      else
        ok "Done — run {{exec zsh}} (or {{rp}}) to reload your shell"
      fi
    fi
    # sys sync all: now the other machines, each over ssh.
    if [[ "$ARG" == "all" ]]; then
      ssh_sync_others || true
    elif [[ -n "$ARG" ]]; then
      die "Unknown: sys sync $ARG — try {{sys sync}}, or {{sys sync all}}"
    fi
    ;;

  push)
    doing "Saving this machine's config into the repo"
    sync_backup
    if [[ "${DRY_RUN:-0}" != "1" ]]; then
      # keep the Cursor extension list from drifting — but never truncate it
      # to nothing because the cursor command failed
      if has_cmd cursor && exts="$(cursor --list-extensions 2>/dev/null)" && [[ -n "$exts" ]]; then
        printf '%s\n' "$exts" | sort > "$ROOT_DIR/config/cursor-extensions.txt"
      fi
      # capture the Dock as it is now
      "$ROOT_DIR/bin/dump-dock" >/dev/null 2>&1 || true
    fi
    if [[ -n "$(git -C "$ROOT_DIR" status --porcelain)" ]]; then
      if [[ "${DRY_RUN:-0}" == "1" ]]; then
        note "dry run: would commit and push these changes:"
        git -C "$ROOT_DIR" status --short | sed 's/^/      /'
      else
        git -C "$ROOT_DIR" add -A
        git -C "$ROOT_DIR" commit -q -m "Update config files"
        push_repo && ok "Pushed"
      fi
    else
      note "Nothing changed"
    fi
    ;;

  doctor)
    # One emoji per row, then a fixed-width label, so columns line up even
    # though emoji are double width.
    row() { printf '  %s  %s%-9s%s %s\n' "$1" "$WHITE" "$2" "$RESET" "$3"; }
    good() { printf '%s%s%s' "$GREEN" "$1" "$RESET"; }
    bad()  { printf '%s%s%s' "$RED"   "$1" "$RESET"; }
    issues=0

    header "🩺" "System check"

    tools="git brew mise uv gh jq mas duti"; missing=""
    for t in $tools; do has_cmd "$t" || missing="$missing $t"; done
    if [[ -z "$missing" ]]; then
      row "🧰" "Tools" "$(good "all present") ${GREY}$(echo $tools | sed 's/ /, /g')${RESET}"
    else
      row "🧰" "Tools" "$(bad "missing:$(echo $missing | sed 's/ /, /g')")"; issues=1
    fi

    if has_cmd mise; then
      while read -r tool ver _; do
        case "$tool" in
          ruby)   row "💎" "Ruby"   "$(good "$ver")" ;;
          node)   row "📗" "Node"   "$(good "$ver")" ;;
          python) row "🐍" "Python" "$(good "$ver")" ;;
        esac
      done < <(mise ls --current 2>/dev/null)
    fi


    if has_cmd mas; then
      if with_timeout 10 mas list; then row "🛒" "App Store" "$(good reachable)"
      else row "🛒" "App Store" "$(bad "not signed in")"; issues=1; fi
    fi

    if ! ssh_has_key; then
      row "🔑" "SSH key" "$(bad "none") ${WHITE}sys sync${RESET}${GREY} makes one${RESET}"; issues=1
    elif ssh_shared; then
      row "🔑" "SSH key" "$(good shared) ${GREY}$(ssh_trusted_count) machine(s) let in here${RESET}"
    else
      row "🔑" "SSH key" "$(bad "not shared yet") ${WHITE}sys sync${RESET}${GREY} — may need a GitHub login once${RESET}"; issues=1
    fi
    # Passwords staying on is a choice, not a problem: never flagged.
    if ssh_keys_only; then
      row "🔐" "sshd" "$(good "keys only")"
    else
      row "🔐" "sshd" "${GREY}keys and passwords — ${RESET}${WHITE}sys ssh harden${RESET}${GREY} turns passwords off${RESET}"
    fi

    # 1Password's SSH agent — only when something points ssh at it. After a
    # silent update it froze, held its socket and answered nothing, and every
    # login through it hung with nothing on screen to explain why.
    op_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    if [[ -S "$op_sock" ]] && { grep -rqs "1password/t/agent.sock" "$HOME/.ssh/config" "$HOME/.ssh/config.d" ||
                                [[ "${SSH_AUTH_SOCK:-}" == "$op_sock" ]]; }; then
      op_out="$(SSH_AUTH_SOCK="$op_sock" timed 3 ssh-add -l 2>&1)" && op_rc=0 || op_rc=$?
      case "$op_rc" in
        0)   row "🔒" "1Password" "$(good "SSH agent answering") ${GREY}$(printf '%s\n' "$op_out" | grep -c .) key(s)${RESET}" ;;
        1)   row "🔒" "1Password" "$(bad "SSH agent holds no keys") ${GREY}— something points ssh at it (an IdentityAgent line, or SSH_AUTH_SOCK) for nothing; sys's own hosts skip it either way${RESET}"; issues=1 ;;
        142) row "🔒" "1Password" "$(bad "SSH agent not answering") ${GREY}— quit 1Password (Force Quit if needed) and reopen it${RESET}"; issues=1 ;;
        *)   row "🔒" "1Password" "$(bad "SSH agent error") ${GREY}${op_out}${RESET}"; issues=1 ;;
      esac
    fi

    if [[ "$(cat "$ROOT_DIR/.state/dock" 2>/dev/null)" == "$(fingerprint "$ROOT_DIR/config/dock" "$ROOT_DIR/bin/set-dock")" ]]; then
      row "🚀" "Dock" "$(good "matches config/dock") ${GREY}as of the last sync${RESET}"
    else
      row "🚀" "Dock" "${GREY}config/dock changed — ${RESET}${WHITE}sys sync${RESET}${GREY} rebuilds it${RESET}"
    fi

    colour="$("$ROOT_DIR/bin/set-desktop-colour" --check 2>&1)" && rc=0 || rc=$?
    case "$rc" in
      0) row "🎨" "Desktop" "$(good "${colour%% on *}") ${GREY}${colour#* }${RESET}" ;;
      2) row "🎨" "Desktop" "${GREY}no screen to check (over SSH?)${RESET}" ;;
      *) row "🎨" "Desktop" "$(bad "not set") ${GREY}${colour} — ${RESET}${WHITE}sys sync --force${RESET}"; issues=1 ;;
    esac

    if [[ -d "/Applications/Paywall Down.app" ]]; then
      row "🧭" "Paywall" "$(good installed)"
    else
      row "🧭" "Paywall" "$(bad "not installed") ${WHITE}sys setup${RESET}${GREY} — needs Xcode${RESET}"; issues=1
    fi

    if git -C "$ROOT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
      if [[ -z "$(git -C "$ROOT_DIR" status --porcelain)" ]]; then
        row "📦" "Repo" "$(good clean)"
      else
        row "📦" "Repo" "$(bad "uncommitted changes") ${WHITE}sys push${RESET}"; issues=1
      fi
    else
      row "📦" "Repo" "$(bad "not a git repo")"; issues=1
    fi

    echo
    if [[ "$issues" == "0" ]]; then
      printf '  ✅  %sEverything looks good.%s\n\n' "$GREEN" "$RESET"
    else
      printf '  🔧  %sSome things need attention above.%s\n\n' "$RED" "$RESET"
    fi
    ;;


  remove)
    is_macos || die "macOS only."
    remove_everything
    ;;

  ai)
    exec "$ROOT_DIR/bin/ai-brief" ;;

  nas)
    case "${ARGS[0]:-}" in
      "")    nas_show ;;
      open)  nas_open ;;
      *)     die "Unknown: sys nas $ARG — {{sys nas}} shows it, {{sys nas open}} opens its web page" ;;
    esac
    ;;

  tailscale)
    case "${ARGS[0]:-}" in
      up) tailscale_up_all ;;
      *)  die "Unknown: sys tailscale ${ARGS[0]:-} — {{sys tailscale up}} turns it on here, then on every machine this one may log into" ;;
    esac
    ;;

  net)
    is_macos || die "macOS only."
    if [[ -n "${ARGS[0]:-}" ]]; then net_connect "${ARGS[0]}"; else net_list; fi
    ;;

  ssh)
    case "${ARGS[0]:-}" in
      "")      "$ROOT_DIR/bin/ssh-hosts" ;;
      all)     "$ROOT_DIR/bin/ssh-hosts" all ;;
      man)     exec man "$ROOT_DIR/man/man1/sys.1" ;;
      harden)  ssh_harden ;;
      *)       ssh_connect "${ARGS[0]}" ;;
    esac
    ;;



  hostname)
    is_macos || die "macOS only."
    if [[ -n "$ARG" ]]; then set_machine_name "$ARG"; else prompt_machine_name; fi
    [[ "${DRY_RUN:-0}" == "1" ]] || { mkdir -p "$ROOT_DIR/.state" && printf 'asked\n' > "$ROOT_DIR/.state/hostname"; }
    ;;



  extras)
    is_macos || die "macOS only."
    install_extras
    ;;


  ""|-h|--help) usage ;;
  *) error "Unknown command: $cmd"; echo; usage; exit 1 ;;
esac
